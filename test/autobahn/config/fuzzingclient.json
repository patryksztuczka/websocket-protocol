{
  "options": { "failByDrop": false },
  "outdir": "./reports/servers",
  "servers": [
    {
      "agent": "WebSocket-Node 1.0.27",
      "url": "ws://host.docker.internal:8080",
      "options": { "version": 18 }
    }
  ],
  "cases": [
    "1.*",
    "2.*",
    "3.*",
    "4.*",
    "5.*",
    "6.1.*",
    "6.2.*",
    "6.5.*",
    "6.7.*",
    "6.9.*",
    "6.22.*",
    "6.23.*"
  ],
  "exclude-cases": ["9.*", "10.*", "12.*", "13.*"],
  "exclude-agent-cases": {}
}
